PORT=3005
MAX_TOKEN=your_max_api_token_here
MAX_CHAT_ID=your_max_chat_id_here

# Супер-админ ГСМ (/gsm). Создаётся/обновляется при каждом старте сервера.
# Одинаковые значения локально и на проде дают один и тот же аккаунт.
# Пароль — минимум 8 символов; в БД хранится argon2id-хэшем.
# Если в пароле есть #, значение ОБЯЗАТЕЛЬНО в двойных кавычках:
# без них dotenv обрежет всё начиная с #.
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=change_me_please
SUPERADMIN_DISPLAY_NAME=Администратор
